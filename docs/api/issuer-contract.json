{
  "contract": "kalmido-invoice-issuer-api",
  "version": 1,
  "since": "2.1446.0",
  "notice_days": 90,
  "rule": "The frozen contract of the invoice issuer key's routes (/api/v1/issuer...): routes, status codes, the fields of every answer, the error names with their status and class, the request fields, the values of every list and the fixed limits. tests/p6702_office_issuer_contract_test.py holds the running server and the code against this file in the hard suites. A change of this file is a change of the contract: it is named in docs/API.md (Invoice issuer keys > Changes of the contract) and needs a notice of notice_days days for anything an outside system can rely on (a field or a value removed or renamed, a status or an error name changed, a limit lowered); a new optional field in an answer, a new error name on a new route or a limit raised is an addition without notice.",
  "base": "/api/v1",
  "routes": {
    "GET /issuer": {"ok": [200], "errors": ["unknown_field"]},
    "PUT /issuer/clients/by-ref/{ref}": {"ok": [200, 201], "errors": ["unknown_field", "invalid_field", "invalid", "version_required", "too_large", "conflict", "client_trashed", "client_gone", "limit_reached"]},
    "GET /issuer/clients/by-ref/{ref}": {"ok": [200], "errors": ["unknown_field", "invalid_field", "client_trashed", "client_gone"]},
    "POST /issuer/invoices": {"ok": [200, 201], "errors": ["unknown_field", "invalid_field", "invalid", "too_large", "client_unknown", "payee_unknown", "ref_conflict", "totals_mismatch", "client_trashed", "payee_mismatch", "withdrawn", "client_gone", "limit_reached"]},
    "GET /issuer/docs": {"ok": [200], "errors": ["unknown_field", "invalid_field"]},
    "GET /issuer/docs/{id}": {"ok": [200], "errors": ["unknown_field"]},
    "GET /issuer/docs/by-ref/{ref}": {"ok": [200], "errors": ["unknown_field", "invalid_field", "withdrawn"]},
    "GET /issuer/docs/{id}/pdf": {"ok": [200], "errors": ["unknown_field", "not_draft", "edited_by_human"]},
    "GET /issuer/docs/{id}/file": {"ok": [200], "errors": ["unknown_field", "invalid_field", "not_final"]},
    "POST /issuer/docs/{id}/withdraw": {"ok": [200], "errors": ["unknown_field", "not_draft", "not_own_draft", "limit_reached"]}
  },
  "every_route_errors": ["unauthorized", "forbidden", "issuer_paused", "issuer_keys_off", "address_refused", "not_found", "rate_limited", "unavailable"],
  "error_classes": {
    "stop": "Stop the queue of this key and alarm a person; never repeat on your own (the key is unknown, ended, expired, of the other environment, the issuers of the office are off or the address is outside the key's rule).",
    "later": "Repeat the same request after Retry-After (a pause, a limit, the rate, a short outage); the queue keeps it.",
    "probe": "A route outside the list or an id that is not the key's own: never repeat; such calls count towards the issuer's self-pause (the by-ref routes do not).",
    "fix": "The request is wrong: correct the data, never repeat it unchanged.",
    "conflict": "409: no blind repeat - read the current state (the answer or a GET), then decide.",
    "gone": "For good: this id is never set up or made again."
  },
  "errors": {
    "unauthorized": {"status": 401, "class": "stop"},
    "issuer_keys_off": {"status": 403, "class": "stop"},
    "address_refused": {"status": 403, "class": "stop"},
    "forbidden": {"status": 403, "class": "probe"},
    "not_found": {"status": 404, "class": "probe"},
    "issuer_paused": {"status": 403, "class": "later", "headers": ["Retry-After"]},
    "rate_limited": {"status": 429, "class": "later", "headers": ["Retry-After"]},
    "limit_reached": {"status": 429, "class": "later", "headers": ["Retry-After"]},
    "unavailable": {"status": 503, "class": "later", "headers": ["Retry-After"]},
    "invalid": {"status": 400, "class": "fix"},
    "unknown_field": {"status": 400, "class": "fix", "extra": ["fields"]},
    "invalid_field": {"status": 400, "class": "fix", "extra": ["field"]},
    "version_required": {"status": 400, "class": "fix", "extra": ["fields"]},
    "too_large": {"status": 413, "class": "fix"},
    "client_unknown": {"status": 404, "class": "fix"},
    "payee_unknown": {"status": 404, "class": "fix"},
    "conflict": {"status": 409, "class": "conflict", "extra": ["current"]},
    "ref_conflict": {"status": 409, "class": "conflict"},
    "totals_mismatch": {"status": 409, "class": "conflict", "extra": ["totals"]},
    "payee_mismatch": {"status": 409, "class": "conflict"},
    "client_trashed": {"status": 409, "class": "conflict"},
    "not_draft": {"status": 409, "class": "conflict"},
    "not_own_draft": {"status": 409, "class": "conflict"},
    "edited_by_human": {"status": 409, "class": "conflict"},
    "not_final": {"status": 409, "class": "conflict"},
    "withdrawn": {"status": 410, "class": "gone"},
    "client_gone": {"status": 410, "class": "gone"}
  },
  "error_body": ["code", "message"],
  "objects": {
    "issuer": ["name", "environment", "mode", "range", "key", "limits", "tax_profile"],
    "issuer.range": ["code"],
    "issuer.key": ["prefix", "expires_at"],
    "issuer.limits": ["max_gross", "day_docs", "day_gross", "day_clients", "open_drafts", "day_mails", "day_withdraw", "review_wait_h"],
    "issuer.tax_profile": ["country", "small_business"],
    "client": ["external_ref", "name", "name_extra", "street", "address_extra", "zip", "city", "country", "vat_id", "email_invoice", "buyer_reference", "doc_lang", "updated_at", "checked"],
    "client_after_put": ["flags"],
    "doc": ["doc_id", "client_ref", "origin", "kind", "status", "range", "number", "date", "service_from", "service_to", "due_date", "totals", "corrects_doc_id", "payments", "mail", "updated_at"],
    "doc_draft": ["missing", "flags"],
    "doc_in_list": ["changed_at"],
    "doc.totals": ["net", "tax", "gross", "currency"],
    "doc.payments[]": ["date", "amount", "method"],
    "doc.mail": ["state", "at"],
    "docs_page": ["docs", "next_cursor"]
  },
  "enums": {
    "environment": ["test", "live"],
    "mode": ["review"],
    "origin": ["issuer", "manual"],
    "kind": ["invoice", "credit"],
    "status": ["draft", "issued", "sent", "partial", "overdue", "paid", "cancelled", "withdrawn"],
    "doc_flags": ["over_limit", "client_new", "client_changed", "vat_territory"],
    "client_flags": ["client_new", "text_suspicious"],
    "mail_state": ["none", "sent", "failed", "bounced"],
    "unit": ["day", "hour", "piece", "minute", "flat"],
    "tax": ["standard", "reduced", "exempt"],
    "vat_note": ["reverse", "abroad", "small", "eu_goods", "export"],
    "paid_method": ["transfer", "card", "direct_debit", "paypal", "online", "cash", "other"],
    "file_kind": ["pdf", "xml"]
  },
  "requests": {
    "client_put": ["name", "name_extra", "street", "address_extra", "zip", "city", "country", "vat_id", "email_invoice", "buyer_reference", "doc_lang", "expect_updated_at"],
    "invoice": ["client_ref", "client", "items", "expect", "service_from", "service_to", "order_ref", "vat_note", "vat_check", "business_check", "wish"],
    "invoice.client": ["external_ref"],
    "invoice.items[]": ["text", "detail", "qty", "unit", "rate", "tax"],
    "invoice.expect": ["net", "tax", "gross"],
    "invoice.wish": ["send", "paid", "payee", "payee_check", "reference", "due_days", "due_date"],
    "invoice.wish.paid": ["amount", "date", "method", "provider", "online_ref"],
    "invoice.vat_check": ["source", "checked_at", "valid", "request_id", "vat_id"],
    "invoice.business_check": ["checked_at", "kind", "source", "ref"],
    "docs_query": ["changed_since", "cursor", "limit"],
    "file_query": ["kind"]
  },
  "refused_invoice_fields": ["date", "number", "range", "series", "finalize", "status", "currency", "iban", "bic", "link", "payment_link", "discount", "intro", "closing", "project_title", "customer_no", "notes"],
  "limits": {
    "ref_pattern": "^[A-Za-z0-9._:-]{1,64}$",
    "reference_pattern": "^[A-Z0-9-]{1,35}$",
    "body_bytes": 65536,
    "items": 50,
    "item_text": 200,
    "item_detail": 1000,
    "order_ref": 80,
    "price_places": 4,
    "calls_a_minute": 60,
    "previews_a_minute": 10,
    "files_a_minute": 10,
    "client_changes_a_day": 200,
    "docs_page_max": 500,
    "key_days_max": 365,
    "due_min_days": 7,
    "self_pause_targets_an_hour": 20
  }
}
